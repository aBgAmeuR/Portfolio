---
import { impact } from "../../contents/impact";
import SectionTitle from "../SectionTitle.astro";
import MusicCard from "../player/music-card.astro";

export type Props = {
    className?: string;
}

const { className } = Astro.props;
---

<section class={`px-6 flex flex-col gap-2 ${className}`} aria-labelledby="tracks-title">
    <SectionTitle title="Impact" id="tracks-title" />
    <div class="flex flex-col">
        {impact.map((music) => <MusicCard {...music} />)}
    </div>
</section>
