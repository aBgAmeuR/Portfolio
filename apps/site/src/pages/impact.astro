---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import AudioPlayer from "../components/player/player.astro";
import ImpactList from "../components/impact/impact-list.astro";
import PlatformLinks from "../components/impact/platform-links.astro";

const PLATFORM_LINKS = {
	soundcloudUrl: "https://soundcloud.com/abgameur",
	youtubeUrl: "https://www.youtube.com/@abgameur",
};
---

<Layout>
	<Header showTitle={false} />
	<div class="px-6 mb-4 flex gap-2">
		<div class="flex flex-col gap-2">
			<img
				src="/impact_cover.png"
				alt="Couverture de l'album Impact"
				class="rounded-lg shadow-lg object-cover"
				loading="eager"
				width="300"
				height="300"
			/>
			<PlatformLinks
				soundcloudUrl={PLATFORM_LINKS.soundcloudUrl}
				youtubeUrl={PLATFORM_LINKS.youtubeUrl}
				className="justify-center sm:justify-start"
			/>
		</div>
		<ImpactList className="mb-4 w-full" />
	</div>
	<AudioPlayer />
</Layout>
